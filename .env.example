# ========================================================
# GLORY EDUCATION FRONTEND ENVIRONMENT CONFIGURATION
# ========================================================

# Base URL for Backend API Gateway
# In local development: http://localhost:3000/api or http://localhost:5000/api
# In production: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Google sign-in: OAuth client ID from Google Cloud Console (leave empty to hide the button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

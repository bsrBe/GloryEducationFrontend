            "body": { "mode": "raw", "raw": "{\n  \"attended\": true\n}" }
          }
        },
        {
          "name": "Check In with Code (Student)",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studentToken}}" }] },
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/check-in" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"GLORY2026\"\n}" }
          }
        },
        {
          "name": "Attendance Report (Staff)",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staffToken}}" }] },
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/attendance" }
          }
        },
        {
          "name": "Update Event Status (Admin)",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}" },
